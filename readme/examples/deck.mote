#import("fonts.mote")
#presentation(
  size = "wide", background = "#0b1226",
  theme = {
    fonts = {heading = "Source Serif 4", body = "Source Sans 3"},
    colors = {text = "#e8ecf6", accent1 = "#f08a3c", accent2 = "#7f9cff"}
  }
)

#let(transit = json("transit.json"))
#let(flush = {top = pt(0), right = pt(0), bottom = pt(0), left = pt(0)})
#let(stars = {
  {x = 0.6, y = 0.5, size = 0.05}, {x = 2.4, y = 0.9, size = 0.03}, {x = 4.1, y = 0.4, size = 0.04},
  {x = 5.8, y = 1.1, size = 0.03}, {x = 7.2, y = 0.6, size = 0.05}, {x = 1.5, y = 6.6, size = 0.04},
  {x = 3.3, y = 7.0, size = 0.03}, {x = 6.4, y = 6.8, size = 0.05}, {x = 12.6, y = 0.5, size = 0.04},
  {x = 12.9, y = 6.9, size = 0.03}, {x = 8.3, y = 7.1, size = 0.04}, {x = 0.4, y = 3.8, size = 0.03}
})

#set shape(
  border = {style = "none"}, margin = flush,
  alignment = "center", vertical_alignment = "middle"
)

#slide(notes = "Open with the discovery itself: a small planet crossing a small, nearby star.")[
  #for star in stars {
    #shape(kind = "ellipse", fill = "#ffffff", opacity = 70,
           position = {x = inch(star.x), y = inch(star.y), width = inch(star.size), height = inch(star.size)})[]
  }
  #shape(kind = "ellipse", fill = "#f08a3c", opacity = 8,
         position = {x = inch(8.6), y = inch(0.75), width = inch(6.0), height = inch(6.0)})[]
  #shape(kind = "ellipse", fill = "#f08a3c", opacity = 16,
         position = {x = inch(9.25), y = inch(1.4), width = inch(4.7), height = inch(4.7)})[]
  #shape(kind = "ellipse", fill = "#ffa95e",
         position = {x = inch(9.9), y = inch(2.05), width = inch(3.4), height = inch(3.4)})[]
  #shape(kind = "ellipse", fill = "#0b1226",
         position = {x = inch(10.65), y = inch(3.0), width = inch(0.58), height = inch(0.58)})[]
  #box(position = {x = inch(0.9), y = inch(1.7), width = inch(7), height = inch(0.4)}, margin = flush,
       text = {size = pt(14), bold = true, color = "#f08a3c"})[
    MERIDIAN TRANSIT SURVEY · RESEARCH NOTE 7
  ]
  #box(position = {x = inch(0.9), y = inch(2.3), width = inch(8.2), height = inch(2.6)}, margin = flush,
       text = {font = "Source Serif 4", size = pt(44), bold = true, color = "#ffffff"})[
    #paragraph[A temperate sub-Neptune]
    #paragraph[around a nearby red dwarf]
  ]
  #box(position = {x = inch(0.9), y = inch(4.0), width = inch(7.5), height = inch(0.8)}, margin = flush,
       text = {size = pt(20), color = "#aab6d3"})[
    Nine transits of MTS-0412 b in 118 nights of photometry
  ]
]

#slide(notes = "Three numbers. The third is why the planet is called temperate.")[
  #box(position = {x = inch(0.9), y = inch(0.7), width = inch(11.5), height = inch(1.1)}, margin = flush,
       text = {font = "Source Serif 4", size = pt(36), bold = true, color = "#ffffff"})[
    MTS-0412 b in three numbers
  ]
  #shape(kind = "round_rect", fill = "#16204a",
         position = {x = inch(0.9), y = inch(2.2), width = inch(3.65), height = inch(4.2)})[
    #paragraph[#span(font = "Source Serif 4", size = pt(80), bold = true, color = "#f08a3c")[2.2]]
    #paragraph[#span(size = pt(19), color = "#d5dcef")[times the radius of the Earth]]
  ]
  #shape(kind = "round_rect", fill = "#16204a",
         position = {x = inch(4.84), y = inch(2.2), width = inch(3.65), height = inch(4.2)})[
    #paragraph[#span(font = "Source Serif 4", size = pt(80), bold = true, color = "#7f9cff")[11.8]]
    #paragraph[#span(size = pt(19), color = "#d5dcef")[days to complete one orbit]]
  ]
  #shape(kind = "round_rect", fill = "#f08a3c",
         position = {x = inch(8.78), y = inch(2.2), width = inch(3.65), height = inch(4.2)})[
    #paragraph[#span(font = "Source Serif 4", size = pt(80), bold = true, color = "#0b1226")[1.3×]]
    #paragraph[#span(size = pt(19), color = "#0b1226")[the sunlight that reaches the Earth]]
  ]
]

#slide(notes = "Each orange point is a model of the transit; the grey points are the binned data.")[
  #box(position = {x = inch(0.9), y = inch(0.7), width = inch(3.9), height = inch(1.8)}, margin = flush,
       text = {font = "Source Serif 4", size = pt(34), bold = true, color = "#ffffff"})[
    A dip of a quarter of one percent
  ]
  #box(position = {x = inch(0.9), y = inch(2.85), width = inch(3.7), height = inch(3.6)}, margin = flush,
       text = {size = pt(17), color = "#aab6d3", paragraph = {spacing = {after = pt(12)}}})[
    #paragraph[Every 11.82 days the star dims by 2,400 parts per million for 1.7 hours.]
    #paragraph[The flat floor of the dip rules out a grazing eclipse between two stars.]
  ]
  #box(position = {x = inch(5.4), y = inch(0.95), width = inch(7.0), height = inch(5.5)}, margin = flush)[
    #chart(
      kind = "line", data = transit.light_curve,
      title = {text = "Flux change in ppm, hours from mid-transit", size = pt(15), color = "#ffffff"},
      colors = {"#8d9bc4", "#f08a3c"}, legend = "bottom",
      gridlines = {major = true, color = "#26315a"}
    )
  ]
]

#set line(border = {color = "#5d6b94", width = pt(2)}, arrow = {to = "triangle", size = "medium"})

#slide(notes = "Close on the catalogue and on the next season's plan.")[
  #box(position = {x = inch(0.9), y = inch(0.7), width = inch(11.5), height = inch(1.1)}, margin = flush,
       text = {font = "Source Serif 4", size = pt(36), bold = true, color = "#ffffff"})[
    48 candidates, and what comes next
  ]
  #box(position = {x = inch(0.6), y = inch(2.0), width = inch(5.6), height = inch(4.9)}, margin = flush)[
    #chart(
      kind = "doughnut",
      data = {categories = {"Candidate", "Confirmed", "Marginal", "Binary"},
              series = {{name = "Candidates", values = {27, 9, 8, 4}}}},
      colors = {"#f08a3c", "#7f9cff", "#3f4f86", "#aab6d3"}, legend = "bottom",
      background = "#0b1226",
      data_labels = {value = true}
    )
  ]
  #shape(kind = "round_rect", fill = "#16204a",
         position = {x = inch(6.9), y = inch(2.2), width = inch(5.5), height = inch(1.05)})[
    #span(size = pt(20), bold = true, color = "#ffffff")[Radial velocities · spring 2027]
  ]
  #line(from = {x = inch(9.65), y = inch(3.3)}, to = {x = inch(9.65), y = inch(3.75)})
  #shape(kind = "round_rect", fill = "#16204a",
         position = {x = inch(6.9), y = inch(3.8), width = inch(5.5), height = inch(1.05)})[
    #span(size = pt(20), bold = true, color = "#ffffff")[Mass and density · summer 2027]
  ]
  #line(from = {x = inch(9.65), y = inch(4.9)}, to = {x = inch(9.65), y = inch(5.35)})
  #shape(kind = "round_rect", fill = "#f08a3c",
         position = {x = inch(6.9), y = inch(5.4), width = inch(5.5), height = inch(1.05)})[
    #span(size = pt(20), bold = true, color = "#0b1226")[Transmission spectrum proposal]
  ]
]
