#slide[
#box(position={x=pt(20),y=pt(20),width=pt(560),height=pt(140)})[#table(borders={outside={color="#0f172a",width=pt(2.5)},inside={color="#94a3b8",width=pt(0.75)}})[
#row[#cell(fill="#dbeafe",borders={right={color="#dc2626",width=pt(2)}})[Preferred]#cell(borders={left={color="#2563eb",width=pt(4)}})[Competing]#cell[Control]]
