#font(name="body",latin="Source Sans 3",files={regular="../measurements/fonts/SourceSans3-Regular.ttf",bold="../measurements/fonts/SourceSans3-Bold.ttf"})
#presentation(width=pt(600),height=pt(400),background="#f8fafc",theme={colors={accent1="#2563eb"}})
#slide[
#box(position={x=pt(20),y=pt(20),width=pt(560),height=pt(170)})[#table(cell={margin={all=pt(7)}})[
#row(height=pt(90),height_rule="exact")[#cell[#paragraph[Two paragraphs.]#paragraph[Second paragraph.]]#cell(vertical_alignment="bottom")[Bottom aligned]#cell(no_wrap=true)[A long line that must wrap within this narrow table cell.]]
#row(height=pt(60))[#cell[#span(bold=true,color="#2563eb")[Bold blue] and normal.]#cell[#list[#item[One]#item[Two]]]#cell[#paragraph(alignment="right")[Right]]]]]
#box(position={x=pt(20),y=pt(220),width=pt(560),height=pt(130)})[#table[
#row[#cell(text_direction="tb_rl")[Vertical one]#cell(text_direction="bt_lr",vertical_alignment="center")[Vertical two]#cell(text_direction="rtl")[Ordinary text]]]]]
