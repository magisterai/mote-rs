#document(page={width=pt(320),height=pt(210)},margin={top=pt(20),right=pt(20),bottom=pt(20),left=pt(20)})
Before the merged table.

#table(width=pt(280))[
#row(repeat_header=true)[#cell[Group] #cell[Details]]
#row[#cell(rowspan=5,fill="#eef4ee",vertical_alignment="center")[A merged label] #cell[First row: a few lines of detail demonstrate the beginning of the merged group.]]
#row[#cell[Second row: more detail in natural flow, without authored page breaks or fixed row heights.]]
#row[#cell[Third row: the merged border should continue on the next page without an internal horizontal line.]]
#row[#cell[Fourth row: this text continues the same group and should preserve the repeated header.]]
#row[#cell[Last row in the merged group.]]
#row[#cell[Next group] #cell[An ordinary row closes the table.]]
]
