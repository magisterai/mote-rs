#table(width=pt(372))[
  #row[#cell[
    #ordered_list(id="sequence",start=3)[
      #item[
        #paragraph[Before the nested list.]
        #list[#item[First nested item.] #item[Second nested item.]]
        #paragraph[After the nested list.]
      ]
      #item[Next outer item.]
    ]
  ]]
]
