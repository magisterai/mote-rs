#font(name="body",latin="Source Sans 3",files={regular="../measurements/fonts/SourceSans3-Regular.ttf",bold="../measurements/fonts/SourceSans3-Bold.ttf"})
#presentation(width=pt(600),height=pt(400),background="#f8fafc",theme={colors={accent1="#2563eb"}})
#slide[
#shape(kind="ellipse",position={x=pt(20),y=pt(20),width=pt(165),height=pt(100)},fill="#dbeafe",text={size=pt(24),fit="shrink",margin={left=pt(3),right=pt(3)}})[This text shrinks into the ellipse.]
#shape(kind="round_rect",position={x=pt(220),y=pt(20),width=pt(165),height=pt(70)},fill="#dcfce7",text={size=pt(18),fit="resize_shape"})[This text grows the text area over several lines and preserves the native shape outline.]
#shape(kind="rectangle",position={x=pt(420),y=pt(20),width=pt(160),height=pt(70)},fill="#fef3c7",text={size=pt(20),fit="clip"})[This text clips inside its original rectangle at the bottom.]
#shape(kind="rectangle",position={x=pt(20),y=pt(220),width=pt(250),height=pt(140)},fill="#e0e7ff",text={size=pt(16),paragraph={spacing_after=pt(3)}})[#paragraph[#span(bold=true,color="#2563eb")[Bold] and [linked](https://example.com).]#list[#item[First]#item[Second]]]
#shape(kind="hexagon",position={x=pt(320),y=pt(220),width=pt(250),height=pt(140)},fill="#fce7f3",text={size=pt(16),alignment="right",vertical_alignment="bottom",margin={top=pt(5),right=pt(12),bottom=pt(10)}})[#paragraph[Bottom right]#paragraph[#span(underline=true,highlight="#fef08a")[Highlighted]]]]
