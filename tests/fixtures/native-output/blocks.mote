#font(name="body",files={regular="../measurements/fonts/SourceSans3-Regular.ttf"})
#document(page={width=pt(420),height=pt(510)},margin={top=pt(24),bottom=pt(24),left=pt(24),right=pt(24)},default_font="body",default_size=pt(12))
#heading(level=1,numbering={id="sections",enabled=true})[Lists and paragraph paint]
#paragraph(fill="#e0f0ff",spacing={after=pt(6)},border={bottom={color="#225588"}})[A shaded paragraph wraps onto another line with enough text to exercise the full band width.]
#paragraph(fill="#ffe8d5",spacing={before=pt(3),after=pt(8)},indent={left=pt(12),first_line=pt(8)})[Adjacent shading bridges spacing using the previous fill.]
#list(indent={left=pt(30),hanging=pt(14)})[
#item[Bullet with #span(underline=true)[underlined text].]
#item(checked=true)[Completed task.]
#item(checked=false)[Pending task.]
#item[A nested sequence follows. #ordered_list(format="lower_alpha",start=26)[#item[First letter.]#item[Repeated letter.]]]
]
#ordered_list(id="steps",start=8)[#item[Numbered step.]#item(checked=false)[A task does not consume a number.]#item[Another step.]]
#blockquote(fill="#eef5e8",border={bottom={color="#557722"}})[A quote with #strong[emphasis] and ordinary text.]
#break()
#heading(level=2,numbering={id="sections",enabled=true})[Continued content]
#ordered_list(id="steps")[#item[Continuation.]#item(indent={left=pt(48),hanging=pt(12)})[Item geometry override with a longer line that wraps within its narrower frame.]]
#ordered_list(format="upper_roman",start=9)[#item[Ninth.]#item[Tenth.]]
#list[#item[]#item[After the empty item.]]
#paragraph(fill="#ddeeff")[A final shaded line.]
