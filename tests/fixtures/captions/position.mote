#figure(placement={align="right"},numbering={enabled=true})[
 #label("below")
 #caption(position="below")[Displayed below in native layout]
 #paragraph[Body after authored caption.]
]
#paragraph[See #ref("above",kind="number") and #ref("below",kind="number").]
