#font(name="body",latin="Source Sans 3",files={regular="../measurements/fonts/SourceSans3-Regular.ttf",bold="../measurements/fonts/SourceSans3-Bold.ttf",italic="../measurements/fonts/SourceSans3-It.ttf"})
#font(name="mono",latin="Courier New",word_line_height=1.6)
#document(default_font="body",default_size=pt(12),page={width=pt(500),height=pt(500)},margin={top=pt(30),right=pt(30),bottom=pt(30),left=pt(30)})
#paragraph[Shape text uses drawing line spacing within a document.]
#shape(position={x=pt(30),y=pt(90),width=pt(210),height=pt(180)},fill="#eff6ff",text={font="mono",size=pt(17),vertical_alignment="bottom",margin={all=pt(8)}})[#paragraph[Monospace lines wrap inside the shape and align at the bottom.]]
#shape(position={x=pt(260),y=pt(90),width=pt(210),height=pt(180)},fill="#dcfce7",text={font="body",size=pt(20),vertical_alignment="center",fit="shrink",margin={all=pt(8)}})[#paragraph[Inline #code[code words wrap onto several lines] within ordinary text.]]
#shape(position={x=pt(30),y=pt(300),width=pt(440),height=pt(160)},fill="#fef3c7",text={font="mono",size=pt(18),vertical_alignment="center",margin={all=pt(8)},paragraph={spacing={line={rule="exact",value=pt(24)}}}})[#paragraph[Explicit line spacing remains fixed when the font declares a document line-height calibration.]]
