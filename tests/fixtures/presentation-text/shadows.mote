  #box(name="Shrink",position={x=pt(32),y=pt(32),width=pt(240),height=pt(40)},fill="#e0f2fe",shadow={opacity=20},text={size=pt(32),fit="shrink",margin={left=pt(4),right=pt(4),top=pt(4),bottom=pt(4)}})[Shrinking text keeps its measured position and fitting.]
