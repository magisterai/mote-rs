#paragraph[Before #checkbox()]
#paragraph[#checkbox(checked=true) after]
#paragraph[Before #field("PAGE")]
#paragraph[#field("DATE") after]
#paragraph[Before #comment[ body ]]
#paragraph[#comment[ body ] after]
#paragraph[#comment[] after]
#paragraph[Before #comment[]]
#paragraph[Preserved #span(preserve_space=true)[ #checkbox() ] after]
#paragraph[#math("x") before and after #math("y")]
