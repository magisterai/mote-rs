#paragraph[Implicit default font and size.]
#paragraph(style = "body text", spacing_after = pt(0))[Before #span(font = "Arial", size = pt(16), bold = true, italic = true, color = "#f00", highlight = "#ff0", underline = true, small_caps = true, strike = true)[outer #span(style = "Accent", size = pt(12))[styled #span(bold = true)[direct] styled] outer] after.]
#paragraph(style = "Body_Text")[Exact style lookup.]
#paragraph[#span(font = "scripted")[Script-only alias] #span(font = "mono")[Declared mono alias] #span(font = "Arial")[Literal font]]
#paragraph[#span(font = "Arial", size = pt(16), bold = true)[before #code(style = "Snippet", preserve_space = true)[code	text] after]]
#paragraph[#code[Default code style]]
