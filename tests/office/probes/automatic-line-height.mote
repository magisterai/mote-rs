#document(
  default_font = "Helvetica",
  default_size = pt(11),
  page = { size = "letter", orientation = "portrait" },
  margin = { top = pt(72), right = pt(72), bottom = pt(72), left = pt(72) }
)
#style(
  name = "Normal",
  type = "paragraph",
  run = { font = "Helvetica", size = pt(11) },
  paragraph = { spacing = { before = pt(0), after = pt(0), line = { rule = "multiple", value = 1.0 } } }
)

#set paragraph(style = "Normal")

AUTOMATIC LINE HEIGHT: Word derives a single line from the font metrics and scales it by the multiple.

#style(
  name = "Helvetica9x10",
  type = "paragraph",
  based_on = "Normal",
  run = { font = "Helvetica", size = pt(9) },
  paragraph = { spacing = { before = pt(0), after = pt(0), line = { rule = "multiple", value = 1.0 } } }
)

#paragraph(style = "Helvetica9x10")[Helvetica 9 points at 1.0 lines, line 1.]

#paragraph(style = "Helvetica9x10")[Helvetica 9 points at 1.0 lines, line 2.]

#paragraph(style = "Helvetica9x10")[Helvetica 9 points at 1.0 lines, line 3.]

