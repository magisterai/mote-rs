#document(
  default_font = "Helvetica",
  default_size = pt(11),
  page = { size = "letter", orientation = "portrait" },
  margin = { top = pt(72), right = pt(72), bottom = pt(72), left = pt(72) }
)

#style(
  name = "Normal",
  type = "paragraph",
  run = { font = "Helvetica", size = pt(11) },
  paragraph = { spacing = { before = pt(0), after = pt(0), line = { rule = "exact", value = pt(16) } } }
)

#set paragraph(style = "Normal")

TABLE BORDERS AT A PAGE BREAK: the row that begins a page lies its top border below the top of the text area, and a repeated header row lies the top border of the table below it. Word draws the bottom border of the table beneath the last row on a page, so a row fits the foot of a page that holds it and the excess of that border over its own.

#table(borders = { top = { width = pt(6), color = "#000000" }, bottom = { width = pt(6), color = "#000000" }, inside_h = { width = pt(0.5), color = "#94a3b8" }, inside_v = { width = pt(0.5), color = "#94a3b8" }, left = { width = pt(0.5), color = "#94a3b8" }, right = { width = pt(0.5), color = "#94a3b8" } })[
  #row(repeat_header = true)[#cell[Header]#cell[Header beside]]
  #row[#cell[Body 0]#cell[Beside]]
