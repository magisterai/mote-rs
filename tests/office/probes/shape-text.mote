#document(
  default_font = "Helvetica",
  default_size = pt(11),
  page = { size = "letter" },
  margin = { top = pt(72), right = pt(72), bottom = pt(72), left = pt(72) }
)

SHAPE TEXT: Word lays out the text of a shape as it lays out body text, aligns the block of lines within the text rectangle, and keeps the text clear of the inner half of the outline.

#shape(
  name = "Shape 1",
  kind = "rect",
  position = { x = pt(72), y = pt(120), width = pt(220), height = pt(100) },
  border = { color = "#2563EB", width = pt(1) },
  text = {
    font = "Aptos",
    size = pt(11),
    alignment = "left",
    vertical_alignment = "top",
    margin = { top = pt(5), right = pt(8), bottom = pt(5), left = pt(8) }
  }
)[Aptos 11 top one]

#shape(
  name = "Shape 2",
  kind = "rect",
