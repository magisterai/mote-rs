#document(
  default_font = "Helvetica",
  default_size = pt(11),
  page = { size = "letter", orientation = "portrait" },
  margin = { top = pt(72), right = pt(72), bottom = pt(72), left = pt(72) }
)
#style(
  name = "Normal",
  type = "paragraph",
  run = { font = "Helvetica", size = pt(11) },
  paragraph = { spacing = { before = pt(0), after = pt(4), line = { rule = "multiple", value = 1.0 } } }
)

SCRIPT POSITION: Word draws a superscript or subscript at a reduced size and moves its baseline by a part of the font size, whatever the line spacing. A note reference is a superscript.

#style(
  name = "S1",
  type = "paragraph",
  based_on = "Normal",
  run = { font = "Helvetica", size = pt(9) },
  paragraph = { spacing = { before = pt(0), after = pt(4), line = { rule = "multiple", value = 1.0 } } }
)

#paragraph(style = "S1")[baseH9m10 #superscript[upH9m10] endH9m10#footnote[Note of H9m10.]]

#paragraph(style = "S1")[lowH9m10 #subscript[dnH9m10] tailH9m10]

