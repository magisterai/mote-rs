#document(default_font = "Helvetica", default_size = pt(11), page = { size = "letter" }, margin = { top = pt(72), right = pt(72), bottom = pt(72), left = pt(72) })

#paragraph(spacing = { before = pt(0), after = pt(0), line = { rule = "exact", value = pt(20) } })[PAGE BREAK: a page break below a full page leaves no page empty, and the block after a page break lies at the head of its page without the space before it.]

#paragraph(spacing = { before = pt(0), after = pt(0), line = { rule = "exact", value = pt(620) } })[Filler one of 620 points, which fills the page.]

#break(type = "page")

Paragraph two after a break below a full page.

#break(type = "page")

