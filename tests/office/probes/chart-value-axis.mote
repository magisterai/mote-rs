#document(
  default_font = "Helvetica",
  default_size = pt(11),
  page = { size = "letter", orientation = "portrait" },
  margin = { top = pt(72), right = pt(72), bottom = pt(72), left = pt(72) }
)

CHART VALUE AXIS: the value axis spans the data with a margin of a twentieth of its range, and labels every major tick at a step chosen from the data and the plot height.

#paragraph[Chart 1: values 171, height 90 points.]

#chart(
  kind = "column",
  width = pt(216),
  height = pt(90),
  data = {
    categories = { "A", "B" },
    series = {
      { name = "S", values = { 85, 171 } }
    }
  },
  legend = false
)

