#table(width = pt(400), cell = { margin = { vertical = pt(4), horizontal = pt(8) } }, borders = { all = { style = "single", width = pt(0.5), color = "#94a3b8" } })[
  #row(repeat_header = true)[#cell(width = pt(200))[#paragraph(fill = "#7CE0F0")[A shaded header: 78.72 to 265.68.]]#cell(width = pt(200))[#paragraph(fill = "#82E0F0", border = { all = { style = "single", width = pt(1), color = "#2563eb", space = pt(3) } })[A boxed header: 276.00 to 468.72.]]]
  #row[
    #cell[#paragraph(fill = "#88E0F0", border = { all = { style = "single", width = pt(1), color = "#2563eb", space = pt(3) } })[A boxed paragraph that crosses the foot of the page: 75.84 to 268.56. The paragraph runs on, so that its row is divided between two pages. The paragraph runs on, so that its row is divided between two pages. The paragraph runs on, so that its row is divided between two pages. The paragraph runs on, so that its row is divided between two pages. The paragraph runs on, so that its row is divided between two pages.]]
    #cell[#paragraph(fill = "#8EE0F0")[A shaded paragraph that crosses the foot of the page: 278.88 to 465.84. The paragraph runs on, so that its row is divided between two pages. The paragraph runs on, so that its row is divided between two pages. The paragraph runs on, so that its row is divided between two pages. The paragraph runs on, so that its row is divided between two pages. The paragraph runs on, so that its row is divided between two pages.]]
  ]
  #row[#cell[The last row.]#cell[A plain paragraph.]]
]
