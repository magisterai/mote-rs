#document(
  default_font = "body",
  default_size = pt(11),
  page = { size = "letter" },
  margin = { top = pt(72), right = pt(72), bottom = pt(72), left = pt(72) }
)

#font(name = "body", latin = "Aptos")

#style(
  name = "Normal",
  type = "paragraph",
  run = { font = "body", size = pt(11) },
  paragraph = { spacing = { before = pt(0), after = pt(0), line = { rule = "multiple", value = 1.0 } } }
)
#style(
  name = "Mark",
  type = "paragraph",
  based_on = "Normal",
  paragraph = { spacing = { before = pt(0), after = pt(0), line = { rule = "exact", value = pt(20) } } }
)

RADICAL HEIGHT: a radical sign is the smallest of its sizes that covers the radicand, so that the height of a radical moves in steps as the radicand grows. Each radical lies between two exact lines, whose baselines are known.

#paragraph(style = "Mark")[Mark 001 before.]

\[
\sqrt{x^2}
\]

#paragraph(style = "Mark")[Mark 002 before.]

\[
\sqrt{x_1^2}
\]

#paragraph(style = "Mark")[Mark 003 before.]

\[
\sqrt{(x)}
\]

#paragraph(style = "Mark")[Mark 004 before.]

\[
\sqrt{\frac{a}{g}}
\]

#paragraph(style = "Mark")[Mark 005 before.]

\[
\sqrt{\frac{f}{g}}
\]

#paragraph(style = "Mark")[Mark 006 before.]

\[
\sqrt{\frac{a^2}{b}}
\]

#paragraph(style = "Mark")[Mark 007 before.]

\[
\sqrt{\frac{a^2}{b_1}}
\]

#paragraph(style = "Mark")[Mark 008 before.]

\[
\sqrt{\frac{(a)}{(b)}}
\]

#paragraph(style = "Mark")[Mark 009 before.]

\[
\sqrt{\sum_{i=1}^{n} x}
\]

