        {
          "baseline": 88.08,
          "text": "PAGE FOOT: W ord keeps a line at the foot of a page when the page holds the line less the",
          "x": 72.0
        },
        {
          "baseline": 108.0,
          "text": "space that a line multiple above one adds beneath its descender. The space before a paragraph",
          "x": 72.0
        },
        {
          "baseline": 128.16,
          "text": "must fit and the space after it need not. A table row must fit whole, and the foot of a column is",
          "x": 72.0
        },
        {
          "baseline": 148.08,
          "text": "the foot of a page. Each sample follows a filler line of exact height at the head of its page, once",
          "x": 72.0
        },
        {
          "baseline": 168.0,
          "text": "with the tallest filler that leaves the sample on the page and once with the shortest that moves it.",
          "x": 72.0
        }
      ],
      "width": 612.0
    },
