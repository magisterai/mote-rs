#presentation(
  size = "wide",
  background = "#f8fafc",
  footer = "Mote PPTX table fidelity",
  date = false,
  slide_number = true
)

#font(name = "body", latin = "Aptos")
#font(name = "display", latin = "Aptos Display")

#style(
  name = "DefaultTable",
  type = "table",
  font = "body",
  table = {
    cell = {
      margin = { top = pt(3), right = pt(6), bottom = pt(3), left = pt(6) },
      vertical_alignment = "middle",
      alignment = "center"
    },
    text = { size = pt(10), color = "#111827" },
    first_row = {
      fill = "#dbeafe",
      text = { bold = true }
    },
    first_column = {
      text = { bold = true }
    },
    last_row = {
      fill = "#fff7ed",
      text = { bold = true }
    },
    banding = {
      rows = true,
      even = { fill = "#f8fafc" }
    },
    borders = {
      outside = { style = "single", color = "#334155", width = pt(1) },
      inside = { style = "single", color = "#cbd5e1", width = pt(0.5) }
    }
  }
)

#set table(style = "DefaultTable")

#slide(notes = "The first table is plain markdown with table defaults. The second table uses explicit native table properties.")[
  #box(
    position = { x = inch(0.7), y = inch(0.35), width = inch(12), height = inch(0.55) },
    margin = { top = pt(0), right = pt(0), bottom = pt(0), left = pt(0) }
  )[
    #span(font = "display", size = pt(22), bold = true, color = "#111827")[Markdown Table With Defaults]
  ]

  #box(position = { x = inch(0.8), y = inch(1.15), width = inch(11.7), height = inch(2.1) })[
    #table(width = inch(10.7), alignment = "center")[
      #row(repeat_header = true, height = pt(28))[
        #cell(width = inch(2.675))[Category]
        #cell(width = inch(2.675))[Owner]
        #cell(width = inch(2.675), alignment = "left")[Status]
        #cell(width = inch(2.675), alignment = "right")[Budget]
      ]
      #row[
        #cell[Parser]
        #cell[Engineering]
        #cell(alignment = "left")[Complete]
        #cell(alignment = "right")[$4,200]
      ]
      #row[
        #cell[Emitter]
        #cell[Engineering]
        #cell(alignment = "left")[In review]
        #cell(alignment = "right")[$6,800]
      ]
      #row[
        #cell[Total]
        #cell[]
        #cell[]
        #cell(alignment = "right")[$11,000]
      ]
    ]
  ]

  #box(
    position = { x = inch(0.7), y = inch(3.85), width = inch(12), height = inch(0.45) },
    margin = { top = pt(0), right = pt(0), bottom = pt(0), left = pt(0) }
  )[
    #span(font = "display", size = pt(18), bold = true, color = "#111827")[Plain Markdown Table]
  ]

  #box(position = { x = inch(0.8), y = inch(4.45), width = inch(11.7), height = inch(1.65) })[
    | Area | Status | Owner |
    | --- | :---: | ---: |
    | Markdown headings | Ready | Parser |
    | Markdown tables | Styled | Emitter |
  ]
]

#slide(notes = "This slide verifies native PowerPoint table merge cells: colspan, rowspan, and a combined row/column span.")[
  #box(
    position = { x = inch(0.7), y = inch(0.35), width = inch(12), height = inch(0.6) },
    margin = { top = pt(0), right = pt(0), bottom = pt(0), left = pt(0) }
  )[
    #span(font = "display", size = pt(22), bold = true, color = "#111827")[Merged Table Cells]
  ]

  #box(position = { x = inch(0.8), y = inch(1.15), width = inch(11.7), height = inch(4.8) })[
    #table(width = inch(10.7), alignment = "center")[
      #row(height = pt(32))[
        #cell(colspan = 4, fill = "#dbeafe", alignment = "center")[Merged header across four columns]
      ]
      #row[
        #cell(width = inch(2.675), rowspan = 2, fill = "#f8fafc", vertical_alignment = "middle")[Rowspan owner]
        #cell(width = inch(2.675))[Task]
        #cell(width = inch(2.675), alignment = "center")[Status]
        #cell(width = inch(2.675), alignment = "right")[Budget]
      ]
      #row[
        #cell(colspan = 2, fill = "#fff7ed")[Parser and emitter coverage]
        #cell(alignment = "right")[$11,000]
      ]
      #row[
        #cell(rowspan = 2, colspan = 2, fill = "#e0f2fe", vertical_alignment = "middle", alignment = "center")[Combined row and column span]
        #cell[Right A]
        #cell[Right B]
      ]
      #row[
        #cell[Lower A]
        #cell[Lower B]
      ]
    ]
  ]
]
