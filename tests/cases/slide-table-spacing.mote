#presentation(width=pt(600), height=pt(420), theme={fonts={heading="Arial", body="Arial"}})
#style(name="SpacedTable", type="table", table={
  text={font="Arial", size=pt(16)},
  paragraph={alignment="left", spacing_before=pt(4), spacing_after=pt(12)},
  cell={margin={top=pt(10),right=pt(10),bottom=pt(10),left=pt(10)}, fill="#eff6ff"},
  borders={all={width=pt(0.5), color="#94a3b8"}}
})
#slide[
  #box(position={x=pt(30), y=pt(20), width=pt(540), height=pt(40)}, text={font="Arial", size=pt(22)})[
    Paragraph spacing and vertical alignment
  ]
  #box(position={x=pt(30), y=pt(80), width=pt(540), height=pt(240)})[
