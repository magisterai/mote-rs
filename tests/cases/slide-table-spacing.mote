      #row[
        #cell(vertical_alignment="top")[#paragraph[First top]#paragraph[Second top]]
        #cell(vertical_alignment="center")[#paragraph[First middle]#paragraph[Second middle]]
        #cell(vertical_alignment="bottom")[#paragraph[First bottom]#paragraph[Second bottom]]
      ]
    ]
  ]
  #box(position={x=pt(30), y=pt(345), width=pt(540), height=pt(45)}, text={font="Arial", size=pt(14)})[
    Each paragraph inherits 4 pt before and 12 pt after.
    Vertical alignment includes the complete paragraph stack.
  ]
]
#slide[
  #box(position={x=pt(30), y=pt(20), width=pt(540), height=pt(40)}, text={font="Arial", size=pt(22)})[
