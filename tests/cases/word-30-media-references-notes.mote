  #caption[The Mote reference logo.]
]

The first figure is #ref(target = "mote-logo", display = "number", fallback = "Figure 1") on page #ref(target = "mote-logo", display = "page", fallback = "1").

#figure(kind = "image", alignment = "left", numbering = { enabled = true, id = "figures", label = "Figure" })[
  #image(
    src = "assets/mote-logo.png",
    name = "Linked Mote Logo",
    description = "Linked logo with visual controls",
    alt = "Linked Mote logo",
    link = "https://example.com",
    crop = { top = 2, right = 2, bottom = 2, left = 2 },
    border = { color = "#336699", width = pt(1), style = "dashed" }
  )
  #caption[Linked image with crop and a dashed border.]
]

