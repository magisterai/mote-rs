#presentation(
  size = "wide",
  background = "#f8fafc",
  footer = "Mote presentation image geometry",
  date = false,
  slide_number = true
)

#font(name = "display", latin = "Aptos Display")

#slide(notes = "The same asymmetric image exposes fit, crop, and flip differences without relying on subjective photography.")[
  #box(position = { x = inch(0.65), y = inch(0.35), width = inch(12), height = inch(0.6) }, margin = { top = pt(0), right = pt(0), bottom = pt(0), left = pt(0) })[
    #span(font = "display", size = pt(24), bold = true, color = "#111827")[Image Fit, Crop, And Flip]
  ]

  #box(position = { x = inch(0.8), y = inch(1.35), width = inch(3.7), height = inch(2.0) }, fit = "contain", border = { color = "#94a3b8", width = pt(1) })[
    #image(src = "assets/mote-logo.png", alt = "Contained asymmetric Mote mark")
  ]

  #box(position = { x = inch(4.82), y = inch(1.35), width = inch(3.7), height = inch(2.0) }, fit = "cover", border = { color = "#2563eb", width = pt(1) })[
    #image(src = "assets/mote-logo.png", alt = "Covered asymmetric Mote mark")
  ]

  #box(position = { x = inch(8.84), y = inch(1.35), width = inch(3.7), height = inch(2.0) }, fit = "cover")[
    #image(
      src = "assets/mote-logo.png",
      alt = "Cropped, covered, and flipped asymmetric Mote mark",
      crop = { top = "8%", right = "18%", bottom = "6%", left = "4%" },
      flip_horizontal = true,
      border = { color = "#059669", width = pt(2), style = "dashed" }
    )
  ]

  #box(position = { x = inch(0.8), y = inch(3.7), width = inch(11.74), height = inch(1.7) }, fit = "contain")[
    #image(src = "assets/evidence_stack.png", alt = "Wide contain reference")
  ]
]

#slide(notes = "Rotation, effects, border, and hyperlink should remain attached to the same picture geometry.")[
  #box(position = { x = inch(0.65), y = inch(0.35), width = inch(12), height = inch(0.6) }, margin = { top = pt(0), right = pt(0), bottom = pt(0), left = pt(0) })[
    #span(font = "display", size = pt(24), bold = true, color = "#111827")[Rotation, Effects, And Link Geometry]
  ]

  #box(position = { x = inch(0.9), y = inch(1.45), width = inch(5.3), height = inch(3.7) }, fit = "contain")[
    #image(
      src = "assets/hero_neural.png",
      alt = "Unrotated neural reference",
      border = { color = "#64748b", width = pt(1) }
    )
  ]

  #box(position = { x = inch(7.05), y = inch(1.45), width = inch(5.3), height = inch(3.7) }, fit = "contain")[
    #image(
      src = "assets/hero_neural.png",
      alt = "Rotated linked neural reference",
      link = "https://example.com/image-review",
      rotation = "27deg",
      flip_vertical = true,
      border = { color = "#dc2626", width = pt(2), style = "dashed" },
      effects = { brightness = 8, contrast = 10, transparency = 12, grayscale = true }
    )
  ]
]
