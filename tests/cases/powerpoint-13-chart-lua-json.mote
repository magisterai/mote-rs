#font(name = "display", latin = "Aptos Display")
#font(name = "body", latin = "Aptos")

#presentation(
  size = "wide",
  background = "#f8fafc",
  footer = "Mote charts — Lua + JSON",
  date = false,
  slide_number = true,
  theme = {
    name = "Mote Lua JSON Charts",
    colors = { background = "#f8fafc", text = "#111827" },
    fonts = { heading = "display", body = "body" }
  }
)

#function monthly_chart()
  local source = json("data/chart_lua_json.json")
  local categories = {}
  local actual = {}
  local plan = {}
  local stretch = {}
  for _, row in ipairs(source.monthly) do
    categories[#categories + 1] = row.month
    actual[#actual + 1] = row.actual
    plan[#plan + 1] = row.plan
    stretch[#stretch + 1] = row.stretch
  end
  return document.chart({
    kind = "line",
    title = "Monthly JSON Output",
    data = {
      categories = categories,
      series = {
        { name = "Actual", values = actual },
        { name = "Plan", values = plan },
        { name = "Stretch", values = stretch }
      }
    },
    axis = {
      category = { title = "Month" },
      value = { title = "Units" }
    },
    gridlines = true,
    colors = { "#0f766e", "#7c3aed", "#ea580c" },
    legend = { position = "bottom" }
  })
end

#function mix_chart()
  local source = json("data/chart_lua_json.json")
  local categories = {}
  local values = {}
  for _, row in ipairs(source.mix) do
    categories[#categories + 1] = row.name
    values[#values + 1] = row.value
  end
  return document.chart({
    kind = "pie",
    title = "JSON Revenue Mix",
    data = {
      categories = categories,
      series = { { name = "Share", values = values } }
    },
    data_labels = { percentage = true, position = "best_fit" },
    colors = { "#0f766e", "#7c3aed", "#ea580c", "#2563eb" },
    legend = { position = "right" }
  })
end

#slide(notes = "Both charts load and reshape the same row-oriented JSON file through Lua. Colors and legend positions are explicit so this case isolates Lua and JSON behavior from chart defaults.")[
  #box(position = { x = inch(0.65), y = inch(0.35), width = inch(12), height = inch(0.65) }, margin = { top = pt(0), right = pt(0), bottom = pt(0), left = pt(0) })[
    #span(font = "display", size = pt(24), bold = true, color = "#111827")[Lua Reshapes JSON Into Editable Charts]
  ]

  #box(position = { x = inch(0.7), y = inch(1.15), width = inch(5.8), height = inch(5.05) })[
    #monthly_chart()
  ]

  #box(position = { x = inch(6.85), y = inch(1.15), width = inch(5.8), height = inch(5.05) })[
    #mix_chart()
  ]
]
