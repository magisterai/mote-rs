#font(name = "display", latin = "Aptos Display")
#font(name = "body", latin = "Aptos")

#presentation(
  size = "wide",
  background = "#f8fafc",
  footer = "Mote chart defaults",
  date = false,
  slide_number = true,
  theme = {
    name = "Mote Chart Defaults",
    colors = { background = "#f8fafc", text = "#111827" },
    fonts = { heading = "display", body = "body" }
  }
)

#slide(notes = "No chart authors colors or a legend. Expected: the three-series column chart uses the shared blue, green, and amber palette with a bottom legend; the line chart uses the same colors with a top legend.")[
  #box(position = { x = inch(0.65), y = inch(0.35), width = inch(12), height = inch(0.65) }, margin = { top = pt(0), right = pt(0), bottom = pt(0), left = pt(0) })[
    #span(font = "display", size = pt(24), bold = true, color = "#111827")[Default Palette And Legend Placement]
  ]

  #box(position = { x = inch(0.7), y = inch(1.15), width = inch(5.8), height = inch(5.05) })[
    #chart(
      kind = "column",
      title = "Monthly Output",
      data = {
        categories = { "Jan", "Feb", "Mar", "Apr", "May" },
        series = {
          { name = "Actual", values = { 18, 24, 31, 39, 47 } },
          { name = "Plan", values = { 16, 23, 29, 36, 44 } },
          { name = "Stretch", values = { 21, 28, 35, 43, 52 } }
        }
      },
      axis = {
        category = { title = "Month" },
        value = { title = "Units" }
      },
      gridlines = true
    )
  ]

  #box(position = { x = inch(6.85), y = inch(1.15), width = inch(5.8), height = inch(5.05) })[
    #chart(
      kind = "line",
      title = "Monthly Trend",
      data = {
        categories = { "Jan", "Feb", "Mar", "Apr", "May" },
        series = {
          { name = "Actual", values = { 18, 24, 31, 39, 47 } },
          { name = "Plan", values = { 16, 23, 29, 36, 44 } },
          { name = "Stretch", values = { 21, 28, 35, 43, 52 } }
        }
      },
      axis = {
        category = { title = "Month" },
        value = { title = "Units" }
      },
      gridlines = true
    )
  ]
]

#slide(notes = "No chart authors colors or a legend. Expected: the redundant single-series column legend is hidden, while the pie chart retains a bottom category legend. Both use the shared default palette.")[
  #box(position = { x = inch(0.65), y = inch(0.35), width = inch(12), height = inch(0.65) }, margin = { top = pt(0), right = pt(0), bottom = pt(0), left = pt(0) })[
    #span(font = "display", size = pt(24), bold = true, color = "#111827")[Single Series And Category Legends]
  ]

  #box(position = { x = inch(0.7), y = inch(1.15), width = inch(5.8), height = inch(5.05) })[
    #chart(
      kind = "column",
      title = "Actual Output",
      data = {
        categories = { "Jan", "Feb", "Mar", "Apr", "May" },
        series = {
          { name = "Actual", values = { 18, 24, 31, 39, 47 } }
        }
      },
      axis = {
        category = { title = "Month" },
        value = { title = "Units" }
      },
      gridlines = true
    )
  ]

  #box(position = { x = inch(6.85), y = inch(1.15), width = inch(5.8), height = inch(5.05) })[
    #chart(
      kind = "pie",
      title = "Revenue Mix",
      data = {
        categories = { "Product", "Services", "Partners", "Other" },
        series = {
          { name = "Share", values = { 46, 27, 17, 10 } }
        }
      },
      data_labels = { percentage = true, position = "best_fit" }
    )
  ]
]
