#metadata(title = "Mote Nested Table Row Splitting", author = "Mote")

#document(
  default_font = "body",
  default_size = pt(10),
  page = { size = "letter" },
  margin = { top = pt(54), right = pt(72), bottom = pt(54), left = pt(72) }
)

#font(name = "body", latin = "Helvetica")

#style(
  name = "Normal",
  type = "paragraph",
  run = { size = pt(10), color = "#111827" },
  paragraph = {
    spacing = {
      before = pt(0),
      after = pt(0),
      line = { rule = "exact", value = pt(13) }
    }
  }
)

#style(
  name = "OuterSplitGrid",
  type = "table",
  table = {
    first_row = {
      cell = { fill = "#1e3a8a" },
      text = { bold = true, color = "#ffffff" }
    },
    banding = {
      odd = { cell = { fill = "#eff6ff" } },
      even = { cell = { fill = "#ffffff" } }
    },
    cell = {
      margin = { top = pt(5), right = pt(6), bottom = pt(5), left = pt(6) },
      vertical_alignment = "top",
      borders = { all = { color = "#1e3a8a" } }
    }
  }
)

#style(
  name = "InnerSplitGrid",
  type = "table",
  table = {
    first_row = {
      cell = { fill = "#fef3c7" },
      text = { bold = true, color = "#78350f" }
    },
    banding = {
      odd = { cell = { fill = "#fffbeb" } },
      even = { cell = { fill = "#ffffff" } }
    },
    cell = {
      margin = { top = pt(5), right = pt(5), bottom = pt(5), left = pt(5) },
      vertical_alignment = "top",
      borders = { all = { color = "#d97706" } }
    }
  }
)

#heading(level = 1)[Nested Table Row Splitting]

#paragraph(spacing = { after = pt(10) })[
The NESTED-SPLIT outer row begins late on page 1 and uses default Word row
flow. Its nested row boundaries, not a fixed height or authored page break,
determine where the left cell resumes.
]

#table(
  style = "OuterSplitGrid",
  width = inch(6.5),
  alignment = "center"
)[
  #row(repeat_header = true)[
    #cell(width = inch(4.4))[OUTER LEFT CONTENT]
    #cell(width = inch(2.1))[RIGHT-CELL CONTROL]
  ]
  #row[#cell[SETUP 01 — ordinary row before the nested split.] #cell[CONTROL SETUP 01]]
  #row[#cell[SETUP 02 — ordinary row before the nested split.] #cell[CONTROL SETUP 02]]
  #row[#cell[SETUP 03 — ordinary row before the nested split.] #cell[CONTROL SETUP 03]]
  #row[#cell[SETUP 04 — ordinary row before the nested split.] #cell[CONTROL SETUP 04]]
  #row[#cell[SETUP 05 — ordinary row before the nested split.] #cell[CONTROL SETUP 05]]
  #row[#cell[SETUP 06 — ordinary row before the nested split.] #cell[CONTROL SETUP 06]]
  #row[#cell[SETUP 07 — ordinary row before the nested split.] #cell[CONTROL SETUP 07]]
  #row[#cell[SETUP 08 — ordinary row before the nested split.] #cell[CONTROL SETUP 08]]
  #row[#cell[SETUP 09 — ordinary row before the nested split.] #cell[CONTROL SETUP 09]]
  #row[#cell[SETUP 10 — ordinary row before the nested split.] #cell[CONTROL SETUP 10]]
  #row[#cell[SETUP 11 — ordinary row before the nested split.] #cell[CONTROL SETUP 11]]
  #row[#cell[SETUP 12 — ordinary row before the nested split.] #cell[CONTROL SETUP 12]]
  #row[#cell[SETUP 13 — ordinary row before the nested split.] #cell[CONTROL SETUP 13]]
  #row[#cell[SETUP 14 — ordinary row before the nested split.] #cell[CONTROL SETUP 14]]
  #row[#cell[SETUP 15 — ordinary row before the nested split.] #cell[CONTROL SETUP 15]]
  #row[#cell[SETUP 16 — ordinary row before the nested split.] #cell[CONTROL SETUP 16]]
  #row[#cell[SETUP 17 — ordinary row before the nested split.] #cell[CONTROL SETUP 17]]
  #row[#cell[SETUP 18 — ordinary row before the nested split.] #cell[CONTROL SETUP 18]]
  #row[
    #cell[
      #paragraph[NESTED-LEFT-BEFORE — visible before the complete nested grid.]
      #table(
        style = "InnerSplitGrid",
        width = inch(4.0),
        alignment = "center"
      )[
        #row[
          #cell(width = inch(1.05))[INNER ROW]
          #cell(width = inch(2.95))[INNER CONTENT]
        ]
        #row[
          #cell[NESTED-R01]
          #cell[
            #paragraph[NESTED-R01 LINE A — first nested row begins.]
            #paragraph[NESTED-R01 LINE B — first nested row ends.]
          ]
        ]
        #row[
          #cell[NESTED-R02]
          #cell[
            #paragraph[NESTED-R02 LINE A — second nested row begins.]
            #paragraph[NESTED-R02 LINE B — second nested row ends.]
          ]
        ]
        #row[
          #cell[NESTED-R03]
          #cell[
            #paragraph[NESTED-R03 LINE A — third nested row begins.]
            #paragraph[NESTED-R03 LINE B — third nested row ends.]
          ]
        ]
        #row[
          #cell[NESTED-R04]
          #cell[
            #paragraph[NESTED-R04 LINE A — fourth nested row begins.]
            #paragraph[NESTED-R04 LINE B — fourth nested row ends.]
          ]
        ]
        #row[
          #cell[NESTED-R05]
          #cell[
            #paragraph[NESTED-R05 LINE A — fifth nested row begins.]
            #paragraph[NESTED-R05 LINE B — fifth nested row ends.]
          ]
        ]
        #row[
          #cell[NESTED-R06]
          #cell[
            #paragraph[NESTED-R06 LINE A — sixth nested row begins.]
            #paragraph[NESTED-R06 LINE B — sixth nested row ends.]
          ]
        ]
      ]
      #paragraph[NESTED-LEFT-AFTER — visible after the complete nested grid.]
    ]
    #cell(fill = "#f8fafc")[
      #paragraph[RIGHT-CONTROL LINE 01]
      #paragraph[RIGHT-CONTROL LINE 02]
      #paragraph[RIGHT-CONTROL LINE 03]
      #paragraph[RIGHT-CONTROL LINE 04]
      #paragraph[RIGHT-CONTROL LINE 05]
      #paragraph[RIGHT-CONTROL LINE 06]
      #paragraph[RIGHT-CONTROL LINE 07]
      #paragraph[RIGHT-CONTROL LINE 08]
      #paragraph[RIGHT-CONTROL LINE 09]
      #paragraph[RIGHT-CONTROL LINE 10]
      #paragraph[RIGHT-CONTROL LINE 11]
      #paragraph[RIGHT-CONTROL LINE 12]
      #paragraph[RIGHT-CONTROL LINE 13]
      #paragraph[RIGHT-CONTROL LINE 14]
      #paragraph[RIGHT-CONTROL LINE 15]
    ]
  ]
  #row[
    #cell[NESTED-OUTER-AFTER — ordinary row after the split.]
    #cell[CONTROL AFTER]
  ]
]

#paragraph(spacing = { before = pt(10) }, fill = "#dcfce7")[
REVIEW: the repeated outer header begins page 2; each NESTED-R01 through
NESTED-R06 row remains intact and appears once; NESTED-LEFT-AFTER follows the
inner grid; and every RIGHT-CONTROL line appears once in order.
]
