#metadata(title = "Mote Natural Column Balancing", author = "Mote")

#document(
  default_font = "Helvetica",
  default_size = pt(10),
  page = { size = "letter", orientation = "portrait" },
  margin = { top = pt(54), right = pt(60), bottom = pt(54), left = pt(60) }
)

#style(
  name = "Normal",
  type = "paragraph",
  run = { font = "Helvetica", size = pt(10), color = "#111827" },
  paragraph = {
    spacing = {
      before = pt(0),
      after = pt(3),
      line = { rule = "exact", value = pt(15) }
    }
  }
)

#style(
  name = "Heading1",
  type = "paragraph",
  based_on = "Normal",
  run = { size = pt(19), bold = true, color = "#1e3a8a" },
  paragraph = {
    keep_with_next = true,
    spacing = {
      before = pt(0),
      after = pt(8),
      line = { rule = "exact", value = pt(25) }
    }
  }
)

#set paragraph(style = "Normal")

# Natural Column Balancing

#paragraph(fill = "#dbeafe")[
  SINGLE-COLUMN START — this full-width marker precedes a continuous two-column section on the same physical page.
]

#section(
  properties = { start = "continuous" },
  columns = { count = 2, gap = pt(24), separator = true }
)[
  #paragraph(fill = "#fef3c7")[BALANCE START — no authored column break follows.]
  #paragraph[BALANCE 01 — alpha flow marker.]
  #paragraph[BALANCE 02 — bravo flow marker.]
  #paragraph[BALANCE 03 — charlie flow marker.]
  #paragraph[BALANCE 04 — delta flow marker.]
  #paragraph[BALANCE 05 — echo flow marker.]
  #paragraph[BALANCE 06 — foxtrot flow marker.]
  #paragraph[BALANCE 07 — golf flow marker.]
  #paragraph[BALANCE 08 — hotel flow marker.]
  #paragraph(fill = "#dcfce7")[BALANCE 09 — midpoint flow marker.]
  #paragraph[BALANCE 10 — juliet flow marker.]
  #paragraph[BALANCE 11 — kilo flow marker.]
  #paragraph[BALANCE 12 — lima flow marker.]
  #paragraph[BALANCE 13 — mike flow marker.]
  #paragraph[BALANCE 14 — november flow marker.]
  #paragraph[BALANCE 15 — oscar flow marker.]
  #paragraph[BALANCE 16 — papa flow marker.]
  #paragraph[BALANCE 17 — quebec flow marker.]
  #paragraph[BALANCE 18 — romeo flow marker.]
  #paragraph(fill = "#fef3c7")[BALANCE END — both column bottoms should finish at approximately the same height.]
]

#section(
  properties = { start = "continuous" },
  columns = { count = 1 }
)[
  #paragraph(fill = "#dcfce7")[
    SINGLE-COLUMN RESUME — this full-width marker begins below the naturally balanced two-column section.
  ]
  #paragraph[
    PASS: exactly one page; no explicit page or column break; markers remain in source order; the two column bottoms align before the full-width closing marker.
  ]
]
