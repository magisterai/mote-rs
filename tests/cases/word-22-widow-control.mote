#metadata(title = "Mote Widow Control", author = "Mote")

#document(
  page = { size = "letter" },
  margin = { top = pt(54), right = pt(72), bottom = pt(54), left = pt(72) }
)

#style(
  name = "Normal",
  type = "paragraph",
  run = { size = pt(11), color = "#111827" },
  paragraph = {
    spacing = {
      before = pt(0),
      after = pt(0),
      line = { rule = "exact", value = pt(18) }
    }
  }
)

#style(
  name = "BoundaryRuler",
  type = "paragraph",
  based_on = "Normal",
  run = { size = pt(9), color = "#64748b" },
  paragraph = {
    spacing = {
      before = pt(0),
      after = pt(0),
      line = { rule = "exact", value = pt(36) }
    }
  }
)

#style(
  name = "WidowOn",
  type = "paragraph",
  based_on = "Normal",
  run = { size = pt(12), bold = true, color = "#166534" },
  paragraph = {
    widow_control = true,
    spacing = {
      before = pt(0),
      after = pt(0),
      line = { rule = "exact", value = pt(18) }
    }
  }
)

#style(
  name = "WidowOff",
  type = "paragraph",
  based_on = "WidowOn",
  run = { color = "#6d28d9" },
  paragraph = {
    widow_control = false
  }
)

#set paragraph(style = "Normal")

#paragraph(style = "BoundaryRuler")[ENABLED RULER 01 — fixed 36-point filler line.#line_break()
ENABLED RULER 02 — fixed 36-point filler line.#line_break()
