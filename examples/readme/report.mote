#import("fonts.mote")
#metadata(title = "Halcyon Reef Observatory: 2026 Field Report", author = "Halcyon Reef Observatory")
#document(
  default_font = "Source Sans 3", default_size = pt(10.5),
  page = {size = "letter"},
  margin = {
    top = inch(0.85), right = inch(0.9), bottom = inch(0.8), left = inch(0.9),
    header = inch(0.4), footer = inch(0.4)
  }
)

#style "Normal" (
  run = {font = "Source Sans 3", size = pt(10.5), color = "#2b3a42"},
  paragraph = {spacing = {after = pt(7), line = pt(14.5)}}
)
#style "Title" extends "Normal" (
  run = {font = "Source Serif 4", size = pt(30), bold = true, color = "#0b3b4f"},
  paragraph = {spacing = {before = pt(2), after = pt(8), line = pt(34)}}
)
#style "Kicker" extends "Normal" (
  run = {size = pt(9), bold = true, color = "#0f8a7e"},
  paragraph = {spacing = {after = pt(2)}}
)
#style "Lead" extends "Normal" (
  run = {font = "Source Serif 4", size = pt(13.5), italic = true, color = "#3d5561"},
  paragraph = {spacing = {after = pt(12), line = pt(19)}}
)
#style "Heading2" extends "Normal" (
  run = {font = "Source Serif 4", size = pt(14), bold = true, color = "#0b3b4f"},
  paragraph = {spacing = {before = pt(10), after = pt(5)}, keep_with_next = true}
)
#style(
  name = "SurveyTable", type = "table",
  table = {
    cell = {margin = {top = pt(4), right = pt(8), bottom = pt(4), left = pt(8)}},
    first_row = {cell = {fill = "#0b3b4f"}, text = {bold = true, color = "#ffffff"}},
    banding = {odd = {cell = {fill = "#eef6f5"}}},
    borders = {all = {style = "none"}, bottom = {style = "single", width = pt(1), color = "#0b3b4f"}}
  }
)
#style(
  name = "Callout", type = "table",
  table = {
    cell = {fill = "#fff6e5", margin = {top = pt(9), right = pt(12), bottom = pt(9), left = pt(14)}},
    borders = {all = {style = "none"}, left = {style = "single", width = pt(3), color = "#e0902f"}}
  }
)
#set table(style = "SurveyTable", width = inch(6.7))

#header[#span(size = pt(8.5), bold = true, color = "#0f8a7e")[HALCYON REEF OBSERVATORY]#span(size = pt(8.5), color = "#6b7f88")[  ·  Field Report No. 14]]
#footer[#span(size = pt(8.5), color = "#6b7f88")[Survey season 2026  ·  Prepared for the board of trustees  ·  Page #page_number() of #page_number(kind = "total")]]

#let(survey = json("survey.json"))

#paragraph "Kicker"[#small_caps[Field report · November 2026]]
#paragraph "Title"[The reef is recovering, unevenly]
#paragraph "Lead"[Two years after the 2024 bleaching event, live coral cover has risen at four of our five monitored sites. The gains are real, but they are concentrated where the water stayed coolest.]

Across 212 survey dives between March and September, divers recorded an average
gain of **5.2 percentage points** in live coral cover. The Coral Garden, sheltered
by the northern headland, recovered fastest; the Eastern Wall, exposed to the
warm boundary current, has barely moved.[^method]

## Live coral cover by site

#chart(
  kind = "column", data = survey.cover,
  width = inch(6.7), height = inch(2.5),
  colors = {"#9fc9c4", "#0f8a7e"}, legend = "bottom",
  data_labels = {value = true, position = "outside_end"},
  gridlines = {major = true, color = "#e3ecee"}, gap_width = "60"
)

| Site | Depth | 2024 | 2026 | Change |
| :--- | :--- | ---: | ---: | ---: |
| North Spur | 6–9 m | 18% | 26% | +8 |
| Lagoon Gate | 3–5 m | 24% | 27% | +3 |
| Coral Garden | 4–7 m | 31% | 38% | +7 |
| Eastern Wall | 10–14 m | 15% | 16% | +1 |
| Outer Shelf | 8–12 m | 22% | 29% | +7 |

#table(style = "Callout", width = inch(6.7))[
#row[#cell[#strong[Recommendation.] Concentrate the 2027 restoration budget on the Eastern Wall, where natural recovery has stalled, and extend temperature logging to the boundary current so that the next warm spell is seen weeks in advance.]]
]

[^method]: Cover is estimated from 50-metre photo transects at fixed stations, with each image scored at 100 random points.
