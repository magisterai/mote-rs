  "families": [
    {
      "file": "word-paragraphs.md",
      "title": "Word paragraph properties",
      "description": "Used by paragraphs, headings, quotes, and paragraphs inside list items. Section-boundary properties are included because they are children of paragraph properties.",
      "roots": [
        {
          "type": "w:CT_PPr"
        },
        {
          "type": "w:CT_P",
          "attributes_only": true
        }
      ]
    },
    {
      "file": "word-runs.md",
      "title": "Word inline text properties",
      "description": "Used by spans, strong/emphasis/code content, paragraph marks, and explicit line breaks. Inherited properties and revision metadata are included.",
      "roots": [
        {
          "type": "w:CT_RPr"
        },
        {
          "type": "w:CT_ParaRPr"
        },
        {
          "type": "w:CT_R",
          "attributes_only": true
        },
        {
          "type": "w:CT_Text"
        },
        {
          "type": "w:CT_Br"
        }
      ]
    },
    {
      "file": "numbering.md",
      "title": "Word numbering and list properties",
      "description": "Used by lists, ordered lists, list items, and heading numbering. Includes abstract definitions, concrete instances, level overrides, marker text and formatting, and picture-bullet references.",
      "roots": [
        {
          "type": "w:CT_Numbering"
        }
      ]
    },
    {
      "file": "fonts.md",
      "title": "Font declaration and selection properties",
      "description": "Used by font declarations and text font references. Includes script mappings, theme collections, font metadata, embedding variants, and document-level embedding switches.",
      "roots": [
        {
          "type": "w:CT_FontsList"
        },
        {
          "type": "w:CT_Fonts"
        },
        {
          "type": "a:CT_FontScheme"
        },
        {
          "type": "a:CT_TextFont"
        },
        {
          "type": "p:CT_EmbeddedFontList"
        },
        {
          "type": "w:CT_Settings",
          "fields": [
            "embedTrueTypeFonts",
            "embedSystemFonts",
            "saveSubsetFonts"
          ]
        }
      ]
    },
    {
      "file": "styles.md",
      "title": "Word style properties",
      "description": "Used by style declarations: paragraph, character, numbering, table, and conditional-region properties. Includes table/row/cell property records even though applying table styles remains unsupported.",
      "roots": [
        {
          "type": "w:CT_Styles"
        }
      ]
    },
    {
      "file": "controls.md",
      "title": "Item control properties",
      "description": "Used by task-item checkbox metadata. Includes legacy form fields and structured-document-tag properties, alternative control kinds, and their nested fields.",
      "roots": [
        {
          "type": "w:CT_SdtPr"
        },
        {
          "type": "w:CT_SdtEndPr"
        },
        {
          "type": "w:CT_FFData"
        }
      ]
    },
    {
      "file": "drawing-text.md",
      "title": "DrawingML and PresentationML text properties",
      "description": "Used by presentation text, paragraph/run formatting, bullet controls, and text defaults. Includes text-body context, all nested fill/effect/geometry properties, and slide-master text styles; these context properties are not automatically direct Mote attributes.",
      "roots": [
        {
          "type": "a:CT_TextBody"
        },
        {
          "type": "p:CT_SlideMasterTextStyles"
        }
      ]
    },
